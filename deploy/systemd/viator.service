# Starts the rover's node graph.
#
# Deliberately NOT enabled by install-deploy.sh. Enabling it means the rover comes up
# drive-capable on every power cycle, which is the right behaviour in the field and the
# wrong behaviour on a bench with someone's hands in the chassis. Turn it on when you
# want it:
#
#   sudo systemctl start viator.service      # this boot only
#   sudo systemctl enable viator.service     # every boot from now on
#
# Restarts are Docker's job (see deploy/compose.runtime.yml), so this unit only starts
# and stops. Logs: `docker logs -f viator-rover`, or /var/log/viator for ROS's own files.

[Unit]
Description=Viator rover software
Requires=docker.service viator-can.service
After=docker.service viator-can.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/viator-deploy
ExecStart=/usr/bin/docker compose -f /opt/viator-deploy/compose.runtime.yml up -d
ExecStop=/usr/bin/docker compose -f /opt/viator-deploy/compose.runtime.yml down
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
