<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tui</name>
  <version>0.0.0</version>
  <description>Terminal dashboard showing rover module status and a filtered live log</description>
  <maintainer email="tfrbtcs@uw.edu">trickfire</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>custom_interfaces</exec_depend>
  <exec_depend>lib</exec_depend>
  <!-- textual has no rosdep key, it's pip installed in .devcontainer/Dockerfile -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
