{
    "editor.rulers": [100],
    "files.associations": {
        "*.tcc": "cpp",
        "*.sudoers": "plaintext"
    },
    "files.exclude": {
        "**/node_modules": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.pytest_cache": true,
        "**/__pycache__": true,
        "**/.venv": true
    },

    /* ------------------------------- formatting ------------------------------- */

    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "[shellscript]": {
        "editor.detectIndentation": false,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
    },

    /* --------------------------------- python --------------------------------- */

    "python.analysis.extraPaths": [
        "/opt/ros/humble/lib/python3.10/site-packages",
        "${workspaceFolder}/src",
        "${workspaceFolder}/install/custom_interfaces/local/lib/python3.10/dist-packages"
    ],

    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingModuleSource": "none"
    },

    "python.analysis.exclude": [
        "./build",
        "./install",
        "./log",
        "**/node_modules",
        "**/__pycache__",
        "**/.*"
    ],

    "python.defaultInterpreterPath": "python3",

    /* ----------------------------------- cpp ---------------------------------- */

    "cmake.configureOnOpen": false,
    "cmake.sourceDirectory": "${workspaceFolder}/src/custom_interfaces"
}
